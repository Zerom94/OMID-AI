<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OMID AI Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/dompurify/3.0.6/purify.min.js"></script>
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #0f172a; color: #f8fafc; }
        .agent-card { transition: all 0.3s ease; }
        .agent-card.active { box-shadow: 0 0 10px rgba(168, 85, 247, 0.5); border-color: #a855f7; }
        .prose-invert h1, .prose-invert h2, .prose-invert h3 { color: #e2e8f0; }
        .prose-invert table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
        .prose-invert th, .prose-invert td { border: 1px solid #334155; padding: 0.5rem; text-align: right; }
        .prose-invert th { background-color: #1e293b; }
        @keyframes blink-yellow { 0%, 100% { background-color: #eab308; opacity: 1; box-shadow: 0 0 8px #eab308; } 50% { background-color: #eab308; opacity: 0.2; box-shadow: none; } }
        .blink-yellow { animation: blink-yellow 1s infinite; }
    </style>

<style id="omid-chat-icon-scale">
    /* هدف قرار دادن دقیق دکمه چت در گوشه پایین سمت راست */
    div[class*="fixed"][class*="bottom-"][class*="right-"],
    button[class*="fixed"][class*="bottom-"][class*="right-"] {
        transform: scale(1.5) !important;
        transform-origin: bottom right !important;
        box-shadow: 0 10px 25px rgba(139, 92, 246, 0.6) !important;
    }
    
    /* بزرگ کردن آیکون SVG یا ایموجی داخل دکمه چت */
    div[class*="fixed"][class*="bottom-"][class*="right-"] svg,
    button[class*="fixed"][class*="bottom-"][class*="right-"] svg {
        width: 32px !important;
        height: 32px !important;
    }
    
    /* اگر از فونت آیکون استفاده شده باشد */
    div[class*="fixed"][class*="bottom-"][class*="right-"] i,
    button[class*="fixed"][class*="bottom-"][class*="right-"] i {
        font-size: 32px !important;
    }
</style>


    
    

    <style>
    .flex.overflow-x-auto {
        flex-wrap: wrap !important;
        justify-content: center !important;
        height: auto !important;
        overflow-x: hidden !important;
        gap: 8px !important;
        padding-bottom: 10px !important;
    }
    </style>
    <!-- Force Flex Wrap -->
    



</head>
<body class="p-2 md:p-6">
    <div class="max-w-[1600px] mx-auto">
        <!-- Header -->
        <div class="flex justify-between items-center mb-3">
            <div class="flex items-center gap-3">
                <h1 class="text-2xl md:text-3xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-blue-400 to-purple-600">OMID AI</h1>
                <button onclick="openHistory()" class="bg-gray-700 hover:bg-gray-600 text-white text-xs md:text-sm py-1 px-3 rounded-lg border border-gray-600 flex items-center gap-1 transition">📂 History</button>
            </div>
            <div class="flex items-center gap-2">
                <span class="relative flex h-3 w-3"><span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span><span class="relative inline-flex rounded-full h-3 w-3 bg-green-500"></span></span>
                <span class="text-xs md:text-sm text-gray-400">System Online</span>
            </div>
        </div>

        <!-- Mission Input -->
        <div class="bg-gray-800 rounded-xl p-2 md:p-4 mb-3 flex flex-col md:flex-row gap-2 border border-gray-700 shadow-lg">
            <input type="text" id="missionInput" placeholder="Enter mission or ask a question..." class="flex-1 bg-gray-900 text-white rounded-lg px-3 py-2 border border-gray-700 focus:outline-none focus:border-purple-500 text-sm md:text-base">
            <button onclick="startMission()" id="startBtn" class="bg-gradient-to-r from-blue-600 to-purple-600 text-white font-bold py-2 px-6 rounded-lg hover:opacity-90 transition text-sm md:text-base">Start</button>
        </div>

        <!-- Agent Cards -->
        <div class="grid grid-cols-4 md:flex md:flex-row md:justify-between gap-1 md:gap-3 mb-4 w-full">
            <div id="card-manager" class="agent-card bg-gray-800 p-1 md:p-3 rounded-lg md:rounded-xl border border-gray-700 flex flex-col items-center justify-center md:flex-1 cursor-pointer"><div class="text-[14px] md:text-2xl md:mb-1">🧠</div><div class="font-bold text-[7px] md:text-sm text-center truncate w-full">Manager</div><div id="status-manager" class="text-[6px] md:text-xs text-gray-500 mt-0.5 md:mt-1">Idle</div></div>
            <div id="card-research" class="agent-card bg-gray-800 p-1 md:p-3 rounded-lg md:rounded-xl border border-gray-700 flex flex-col items-center justify-center md:flex-1 cursor-pointer"><div class="text-[14px] md:text-2xl md:mb-1">🔍</div><div class="font-bold text-[7px] md:text-sm text-center truncate w-full">Research</div><div id="status-research" class="text-[6px] md:text-xs text-gray-500 mt-0.5 md:mt-1">Idle</div></div>
            <div id="card-developer" class="agent-card bg-gray-800 p-1 md:p-3 rounded-lg md:rounded-xl border border-gray-700 flex flex-col items-center justify-center md:flex-1 cursor-pointer"><div class="text-[14px] md:text-2xl md:mb-1">💻</div><div class="font-bold text-[7px] md:text-sm text-center truncate w-full">Developer</div><div id="status-developer" class="text-[6px] md:text-xs text-gray-500 mt-0.5 md:mt-1">Idle</div></div>
            <div id="card-analyst" class="agent-card bg-gray-800 p-1 md:p-3 rounded-lg md:rounded-xl border border-gray-700 flex flex-col items-center justify-center md:flex-1 cursor-pointer"><div class="text-[14px] md:text-2xl md:mb-1">📊</div><div class="font-bold text-[7px] md:text-sm text-center truncate w-full">Analyst</div><div id="status-analyst" class="text-[6px] md:text-xs text-gray-500 mt-0.5 md:mt-1">Idle</div></div>
            <div id="card-security" class="agent-card bg-gray-800 p-1 md:p-3 rounded-lg md:rounded-xl border border-gray-700 flex flex-col items-center justify-center md:flex-1 cursor-pointer"><div class="text-[14px] md:text-2xl md:mb-1">🛡️</div><div class="font-bold text-[7px] md:text-sm text-center truncate w-full">Security</div><div id="status-security" class="text-[6px] md:text-xs text-gray-500 mt-0.5 md:mt-1">Idle</div></div>
            <div id="card-recon" class="agent-card bg-gray-800 p-1 md:p-3 rounded-lg md:rounded-xl border border-gray-700 flex flex-col items-center justify-center md:flex-1 cursor-pointer"><div class="text-[14px] md:text-2xl md:mb-1">📡</div><div class="font-bold text-[7px] md:text-sm text-center truncate w-full">Recon</div><div id="status-recon" class="text-[6px] md:text-xs text-gray-500 mt-0.5 md:mt-1">Idle</div></div>
            <div id="card-testing" class="agent-card bg-gray-800 p-1 md:p-3 rounded-lg md:rounded-xl border border-gray-700 flex flex-col items-center justify-center md:flex-1 cursor-pointer"><div class="text-[14px] md:text-2xl md:mb-1">🧪</div><div class="font-bold text-[7px] md:text-sm text-center truncate w-full">Testing</div><div id="status-testing" class="text-[6px] md:text-xs text-gray-500 mt-0.5 md:mt-1">Idle</div></div>
            <div id="card-automation" class="agent-card bg-gray-800 p-1 md:p-3 rounded-lg md:rounded-xl border border-gray-700 flex flex-col items-center justify-center md:flex-1 cursor-pointer"><div class="text-[14px] md:text-2xl md:mb-1">⚙️</div><div class="font-bold text-[7px] md:text-sm text-center truncate w-full">Automation</div><div id="status-automation" class="text-[6px] md:text-xs text-gray-500 mt-0.5 md:mt-1">Idle</div></div>
            <div id="card-memory" class="agent-card bg-gray-800 p-1 md:p-3 rounded-lg md:rounded-xl border border-gray-700 flex flex-col items-center justify-center md:flex-1 cursor-pointer"><div class="text-[14px] md:text-2xl md:mb-1">💾</div><div class="font-bold text-[7px] md:text-sm text-center truncate w-full">Memory</div><div id="status-memory" class="text-[6px] md:text-xs text-gray-500 mt-0.5 md:mt-1">Idle</div></div>
            <div id="card-qc" class="agent-card bg-gray-800 p-1 md:p-3 rounded-lg md:rounded-xl border border-gray-700 flex flex-col items-center justify-center md:flex-1 cursor-pointer"><div class="text-[14px] md:text-2xl md:mb-1">✅</div><div class="font-bold text-[7px] md:text-sm text-center truncate w-full">QC</div><div id="status-qc" class="text-[6px] md:text-xs text-gray-500 mt-0.5 md:mt-1">Idle</div></div>
            <div id="card-auditor" class="agent-card bg-gray-800 p-1 md:p-3 rounded-lg md:rounded-xl border border-gray-700 flex flex-col items-center justify-center md:flex-1 cursor-pointer"><div class="text-[14px] md:text-2xl md:mb-1">🕵️‍♂️</div><div class="font-bold text-[7px] md:text-sm text-center truncate w-full">Auditor</div><div id="status-auditor" class="text-[6px] md:text-xs text-gray-500 mt-0.5 md:mt-1">Idle</div></div>
            <div id="card-content" class="agent-card bg-gray-800 p-3 rounded-lg md:rounded-xl border border-gray-700 flex flex-col items-center justify-center min-w-[70px] h-[80px] md:h-[90px] text-xs text-gray-500 md:text-sm text-center transition-all cursor-pointer hover:bg-gray-700">
    <div class="text-xl mb-1">✍️</div>
    <div class="font-medium">Content</div>
    <div id="status-content" class="text-[10px] md:text-xs text-gray-500 mt-0.5">Idle</div>
</div>

<div id="card-other" class="agent-card bg-gray-800 p-1 md:p-3 rounded-lg md:rounded-xl border border-gray-700 flex flex-col items-center justify-center md:flex-1 cursor-pointer"><div class="text-[14px] md:text-2xl md:mb-1">🤖</div><div class="font-bold text-[7px] md:text-sm text-center truncate w-full">Other</div><div id="status-other" class="text-[6px] md:text-xs text-gray-500 mt-0.5 md:mt-1">Idle</div></div>
        </div>
        <!-- Main Panels -->
        <div class="grid grid-cols-1 md:grid-cols-[3fr_1fr] gap-2 md:gap-4 md:h-[calc(100dvh-250px)]">
            <div class="bg-gray-800 rounded-xl border border-gray-700 flex flex-col h-[400px] md:h-full min-w-0 overflow-hidden">
                <div class="flex flex-row justify-between items-center p-2 border-b border-gray-700 gap-2 flex-wrap">
                    <h2 class="font-bold text-gray-300 text-sm md:text-base whitespace-nowrap">Code Explorer</h2>
                    <div class="flex gap-1 items-center flex-wrap justify-end">
                        <select id="fileSelect" onchange="loadFile()" class="bg-gray-900 text-[10px] md:text-xs text-gray-300 rounded px-1 md:px-3 py-1 md:py-1.5 border border-gray-600 w-[100px] md:w-[150px] truncate"><option value="">-- Select --</option></select>
                        <button onclick="fetchFiles()" class="bg-blue-600 hover:bg-blue-700 text-white text-[10px] md:text-sm px-2 md:px-3 py-1 md:py-1.5 rounded">🔄</button>
                        <button onclick="clearCode()" class="bg-red-600 hover:bg-red-700 text-white text-[10px] md:text-sm px-2 md:px-3 py-1 md:py-1.5 rounded">Clear</button>
                        <button onclick="copyCode()" class="bg-gray-600 hover:bg-gray-700 text-white text-[10px] md:text-sm px-2 md:px-3 py-1 md:py-1.5 rounded">Copy</button>
                        <button onclick="saveFile()" class="bg-purple-600 hover:bg-purple-700 text-white text-[10px] md:text-sm px-2 md:px-3 py-1 md:py-1.5 rounded">Save</button>
                        <button onclick="downloadZip()" class="bg-green-600 hover:bg-green-700 text-white text-[10px] md:text-sm px-2 md:px-3 py-1 md:py-1.5 rounded">ZIP</button>
                    </div>
                </div>
                <div class="flex-1 p-2 md:p-3 overflow-auto">
                    <pre class="whitespace-pre-wrap break-all"><code id="codeContent" class="text-xs md:text-sm text-gray-300 font-mono"># Waiting for instructions...</code></pre>
                </div>
            </div>

            <div class="bg-gray-800 rounded-xl border border-gray-700 flex flex-col h-[400px] md:h-full min-w-0 overflow-hidden">
                <div class="p-2 border-b border-gray-700 flex justify-between items-center">
                    <h2 class="font-bold text-gray-300 text-sm md:text-base">Live Logs</h2>
                    <div class="flex gap-1.5">
                        <div id="log-dot-1" class="w-3 h-3 rounded-full bg-red-500 transition-colors duration-300"></div>
                        <div id="log-dot-2" class="w-3 h-3 rounded-full bg-red-500 transition-colors duration-300"></div>
                        <div id="log-dot-3" class="w-3 h-3 rounded-full bg-red-500 transition-colors duration-300"></div>
                    </div>
                </div>
                <div id="logContainer" class="flex-1 p-2 md:p-3 overflow-y-auto font-mono text-xs md:text-sm space-y-1 break-words">
                    <div class="text-gray-500">> System initialized...</div>
                    <div class="text-green-400">> Connected to logs.</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modals -->
    <div id="reportModal" class="fixed inset-0 bg-black/80 hidden items-center justify-center z-50 p-2 md:p-4">
        <div class="bg-gray-900 border border-gray-600 rounded-xl w-full max-w-4xl max-h-[90vh] flex flex-col shadow-2xl">
            <div class="flex justify-between items-center p-3 md:p-4 border-b border-gray-700 bg-gray-800 rounded-t-xl"><h2 class="text-lg md:text-xl font-bold text-purple-400">📡 Agent Report</h2><button onclick="closeReport()" class="text-gray-400 hover:text-white text-2xl font-bold">&times;</button></div>
            <div id="reportContent" class="p-3 md:p-6 overflow-y-auto text-gray-300 prose prose-invert max-w-none text-right" dir="rtl"></div>
        </div>
    </div>

    <div id="historyModal" class="fixed inset-0 bg-black/80 hidden items-center justify-center z-50 p-2 md:p-4">
        <div class="bg-gray-900 border border-gray-600 rounded-xl w-full max-w-lg max-h-[80vh] flex flex-col shadow-2xl">
            <div class="flex justify-between items-center p-3 md:p-4 border-b border-gray-700 bg-gray-800 rounded-t-xl"><h2 class="text-lg md:text-xl font-bold text-blue-400">📂 Scan History</h2><button onclick="closeHistory()" class="text-gray-400 hover:text-white text-2xl font-bold">&times;</button></div>
            <div id="historyList" class="p-2 md:p-4 overflow-y-auto flex-1 space-y-2"></div>
        </div>
    </div>

    <!-- Chat Widget -->
    <button id="chatFab" onclick="toggleChat()" class="fixed bottom-4 right-4 z-[9999] bg-gradient-to-r from-purple-600 to-blue-600 w-14 h-14 rounded-full shadow-lg flex items-center justify-center text-white text-2xl hover:scale-110 transition-transform shadow-purple-500/50">💬</button>

    <div id="chatWindow" class="hidden fixed inset-0 md:inset-auto md:bottom-20 md:right-4 z-[9999] w-full h-full md:w-[450px] md:h-[650px] bg-gray-900/95 backdrop-blur-xl md:border md:border-gray-600 md:rounded-2xl shadow-2xl flex-col overflow-hidden">
        <div class="bg-gradient-to-r from-purple-900/90 to-blue-900/90 p-4 flex justify-between items-center border-b border-gray-600">
            <h3 class="text-white font-bold text-base flex items-center gap-2"><div class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></div> OMID AI Assistant</h3>
            <button onclick="toggleChat()" class="text-gray-300 hover:text-white text-3xl font-bold px-2">&times;</button>
        </div>
        <div id="chatMessages" class="flex-1 p-4 overflow-y-auto flex flex-col gap-3 text-sm text-gray-200" dir="rtl">
            <div class="bg-gray-800 text-white p-3 rounded-lg rounded-tr-none self-start max-w-[85%] text-xs">سلام! من مدیر OMID AI هستم. چطور می‌توانم کمکتان کنم؟</div>
        </div>
        <div class="p-3 border-t border-gray-700 bg-gray-800/90 flex gap-2 pb-6 md:pb-3">
            <input type="text" id="chatInput" onkeypress="if(event.key === 'Enter') sendChatMessage()" placeholder="پیام خود را بنویسید..." class="flex-1 bg-gray-900 text-white text-sm rounded-lg px-4 py-3 border border-gray-700 focus:outline-none focus:border-purple-500" dir="rtl">
            <button onclick="sendChatMessage()" class="bg-purple-600 hover:bg-purple-700 text-white px-5 py-3 rounded-lg text-sm font-bold transition">ارسال</button>
        </div>
    </div>
    <script>
        let eventSource = null; let currentFilename = "";

        function toggleChat() {
            const win = document.getElementById('chatWindow');
            if (win.style.display === 'none' || win.style.display === '') {
                win.style.display = 'flex';
                win.style.flexDirection = 'column';
            } else {
                win.style.display = 'none';
            }
        }

        function appendChatMessage(text, sender) {
            const box = document.getElementById('chatMessages');
            const div = document.createElement('div');
            div.className = sender === 'user' 
                ? 'bg-purple-700 text-white p-3 rounded-lg rounded-tl-none self-end max-w-[85%] text-sm' 
                : 'bg-gray-800 text-white p-3 rounded-lg rounded-tr-none self-start max-w-[85%] text-sm';
            div.innerText = text;
            box.appendChild(div);
            box.scrollTop = box.scrollHeight;
        }

        function sendChatMessage() {
            const input = document.getElementById('chatInput');
            const text = input.value.trim();
            if (!text) return;
            appendChatMessage(text, 'user');
            input.value = '';
            const btn = document.getElementById('startBtn'); if(btn) { btn.disabled = true; btn.innerText = 'Thinking...'; }
            
            if (eventSource) eventSource.close();
            initSSE();

            fetch('/api/mission', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ goal: text }) });
        }

        function setLogsState(state) {
            const dots = [document.getElementById('log-dot-1'), document.getElementById('log-dot-2'), document.getElementById('log-dot-3')];
            dots.forEach(dot => dot.className = 'w-3 h-3 rounded-full transition-colors duration-300');
            if (state === 'idle') dots.forEach(dot => dot.classList.add('bg-red-500'));
            else if (state === 'working') dots.forEach(dot => dot.classList.add('blink-yellow'));
            else if (state === 'done') dots.forEach(dot => dot.classList.add('bg-green-500'));
        }

        function startMission() {
            const goal = document.getElementById('missionInput').value.trim();
            if (!goal) return alert('Please enter a mission.');
            document.getElementById('startBtn').disabled = true;
            document.getElementById('startBtn').innerText = 'Running...';
            document.getElementById('codeContent').innerText = '# Processing...';
            document.querySelectorAll('.agent-card').forEach(card => { card.classList.remove('active', 'border-green-500', 'border-red-500'); card.classList.add('border-gray-700'); });
            document.querySelectorAll('[id^="status-"]').forEach(el => { el.innerText = 'Idle'; el.className = 'text-[6px] md:text-xs text-gray-500 mt-0.5 md:mt-1'; });
            addLog('> Mission Started', 'text-blue-400');
            setLogsState('working');
            fetch('/api/mission', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ goal: goal }) })
            .then(() => { if (eventSource) eventSource.close(); initSSE(); });
        }

        function initSSE() {
            eventSource = new EventSource('/sse');
            eventSource.onmessage = function(event) {
                const payload = JSON.parse(event.data); const type = payload.type; const data = payload.data;
                if (data.agent && data.status) {
                    const agentName = data.agent.toLowerCase();
                    const card = document.getElementById(`card-${agentName}`);
                    const status = document.getElementById(`status-${agentName}`);
                    if (card && status) {
                        if (data.status === 'Working') { card.classList.add('active'); status.className = 'text-[6px] md:text-xs text-purple-400 animate-pulse font-bold mt-0.5 md:mt-1'; status.innerText = 'Working'; addLog(`> [${data.agent}] Working...`, 'text-purple-400'); }
                        else if (data.status === 'Done') { card.classList.remove('active'); card.classList.add('border-green-500'); status.className = 'text-[6px] md:text-xs text-green-400 font-bold mt-0.5 md:mt-1'; status.innerText = 'Done'; addLog(`> [${data.agent}] Done.`, 'text-green-400'); }
                        else if (data.status === 'Failed') { card.classList.remove('active'); card.classList.add('border-red-500'); status.className = 'text-[6px] md:text-xs text-red-400 font-bold mt-0.5 md:mt-1'; status.innerText = 'Failed'; addLog(`> [${data.agent}] Failed!`, 'text-red-400'); }
                    }
                }
                if (type === 'code_generated' && data.filename && data.code) {
                    document.getElementById('codeContent').innerText = data.code;
                    const sel = document.getElementById('fileSelect');
                    const opt = document.createElement('option'); opt.value = data.filename; opt.innerText = data.filename; sel.appendChild(opt); sel.value = data.filename; currentFilename = data.filename;
                }
                if (type === 'report' && data.content) { showReport(data.content); }
                if (type === 'chat' && data.text) { appendChatMessage(data.text, 'manager'); const btn = document.getElementById('startBtn'); if(btn) { btn.disabled = false; btn.innerText = 'Start'; } }
                if (type === 'all_tasks_done') {
                    const btn = document.getElementById('startBtn'); btn.disabled = false; btn.innerText = 'Start';
                    addLog('> Mission Complete.', 'text-blue-400'); setLogsState('done');
                    const mgrCard = document.getElementById('card-manager'); const mgrStatus = document.getElementById('status-manager');
                    if (mgrCard && mgrStatus) { mgrCard.classList.remove('active'); mgrCard.classList.add('border-green-500'); mgrStatus.className = 'text-[6px] md:text-xs text-green-400 font-bold mt-0.5 md:mt-1'; mgrStatus.innerText = 'Done'; }
                    if (document.getElementById('codeContent').innerText === '# Processing...') { document.getElementById('codeContent').innerText = '# Task completed. No code was generated.'; }
                }
            };
        }

        function addLog(msg, colorClass) { const c = document.getElementById('logContainer'); const d = document.createElement('div'); d.className = colorClass; d.innerText = msg; c.appendChild(d); c.scrollTop = c.scrollHeight; }
        function showReport(m) { document.getElementById('reportContent').innerHTML = DOMPurify.sanitize(marked.parse(m)); document.getElementById('reportModal').classList.remove('hidden'); document.getElementById('reportModal').classList.add('flex'); }
        function closeReport() { document.getElementById('reportModal').classList.add('hidden'); document.getElementById('reportModal').classList.remove('flex'); }
        
        function openHistory() {
            fetch('/api/reports').then(res => res.json()).then(data => {
                const list = document.getElementById('historyList'); list.innerHTML = '';
                if (data.reports.length === 0) list.innerHTML = '<div class="text-gray-400 text-center py-4">No reports found.</div>';
                else data.reports.forEach(f => {
                    const btn = document.createElement('button'); btn.className = 'w-full text-left bg-gray-800 hover:bg-gray-700 p-3 rounded-lg border border-gray-700 flex justify-between items-center';
                    btn.innerHTML = `<span class="truncate max-w-[70%]">📄 ${f}</span> <span class="text-blue-400 text-xs">View &rarr;</span>`;
                    btn.onclick = () => { closeHistory(); fetch(`/api/reports/${f}`).then(r => r.json()).then(x => { if (x.content) showReport(x.content); }); };
                    list.appendChild(btn);
                });
                document.getElementById('historyModal').classList.remove('hidden'); document.getElementById('historyModal').classList.add('flex');
            });
        }
        function closeHistory() { document.getElementById('historyModal').classList.add('hidden'); document.getElementById('historyModal').classList.remove('flex'); }

        function fetchFiles() { fetch('/api/files?t=' + new Date().getTime()).then(res => res.json()).then(data => { const select = document.getElementById('fileSelect'); select.innerHTML = '<option value="">-- Select --</option>'; if (data.files) data.files.forEach(f => { const opt = document.createElement('option'); opt.value = f; opt.innerText = f; select.appendChild(opt); }); }); }
        function loadFile() { const file = document.getElementById('fileSelect').value; if (!file) return; currentFilename = file; fetch(`/api/file/${file}?t=` + new Date().getTime()).then(res => res.json()).then(data => { document.getElementById('codeContent').innerText = data.code || "Empty"; }); }
        function clearCode() { document.getElementById('fileSelect').value = ""; document.getElementById('codeContent').innerText = "# Waiting..."; currentFilename = ""; }
        function copyCode() { navigator.clipboard.writeText(document.getElementById('codeContent').innerText).then(() => alert('Copied!')); }
        function saveFile() { if (!currentFilename) return alert('Select a file.'); fetch(`/api/save/${currentFilename}`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ content: document.getElementById('codeContent').innerText }) }).then(r => r.json()).then(d => alert(d.status === 'success' ? 'Saved!' : 'Error')); }
        function downloadZip() { window.location.href = '/api/download_zip'; }

        window.onload = () => { fetchFiles(); setLogsState('idle'); };
    </script>

<div id="preview-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); z-index: 9999; justify-content: center; align-items: center;">
    <div style="background: #1e1e2e; width: 90%; height: 85%; border-radius: 12px; display: flex; flex-direction: column; overflow: hidden; border: 1px solid #374151;">
        <div style="padding: 10px 20px; background: #111827; display: flex; justify-content: space-between; align-items: center; color: white;">
            <span style="font-weight: bold; font-family: sans-serif;">Live Web App Preview</span>
            <button onclick="document.getElementById('preview-modal').style.display='none'" style="background: #ef4444; color: white; border: none; padding: 5px 15px; border-radius: 5px; cursor: pointer;">Close</button>
        </div>
        <iframe id="preview-iframe" style="width: 100%; height: 100%; border: none; background: white;"></iframe>
    </div>
</div>

<script>
    // گوش دادن به رویداد code_generated برای نمایش پیش‌نمایش
    if (typeof EventSource !== 'undefined') {
        const originalLogEvent = window.logEvent;
        window.logEvent = function(event, data) {
            if (originalLogEvent) originalLogEvent(event, data);
            if (event === 'code_generated' && data.is_html && data.html_content) {
                document.getElementById('preview-iframe').srcdoc = data.html_content;
                document.getElementById('preview-modal').style.display = 'flex';
            }
        };
    }
</script>


<script>
    // این کد به صورت هوشمند تمام پیام‌های سرور را رصد می‌کند
    const originalEventSource = window.EventSource;
    window.EventSource = function(url) {
        const es = new originalEventSource(url);
        const originalAddEventListener = es.addEventListener;
        es.addEventListener = function(type, listener, options) {
            if (type === 'message' || type === 'sse') {
                const wrappedListener = function(event) {
                    try {
                        let data = JSON.parse(event.data);
                        if (data.event === 'code_generated' && data.data && data.data.is_html && data.data.html_content) {
                            const modal = document.getElementById('preview-modal');
                            if (modal) {
                                document.getElementById('preview-iframe').srcdoc = data.data.html_content;
                                modal.style.display = 'flex';
                                console.log("✅ Preview opened successfully!");
                            }
                        }
                    } catch (e) {
                        // اگر پیام JSON نبود، نادیده بگیر
                    }
                    listener(event);
                };
                return originalAddEventListener.call(es, type, wrappedListener, options);
            }
            return originalAddEventListener.call(es, type, listener, options);
        };
        return es;
    };
</script>


    
    <script>
        const origEventSource = window.EventSource;
        window.EventSource = function(url) {
            const es = new origEventSource(url);
            const origAddEventListener = es.addEventListener;
            es.addEventListener = function(type, listener, options) {
                if (type === 'message' || type === 'sse' || type === 'log') {
                    const wrapped = function(event) {
                        try {
                            let data = JSON.parse(event.data);
                            if (data.text && typeof data.text === 'string' && data.text.length > 200) {
                                document.getElementById('article-content').innerText = data.text;
                                document.getElementById('article-modal').style.display = 'flex';
                            }
                            if (data.agent && data.agent.toLowerCase().includes('content')) {
                                const ind = document.getElementById('agent-content-indicator');
                                const stat = document.getElementById('agent-content-status');
                                if (ind && stat) {
                                    stat.innerText = data.status;
                                    ind.style.borderColor = data.status === 'Working' ? '#f59e0b' : (data.status === 'Done' ? '#10b981' : '#374151');
                                }
                            }
                        } catch(e) {}
                        listener(event);
                    };
                    return origAddEventListener.call(es, type, wrapped, options);
                }
                return origAddEventListener.call(es, type, listener, options);
            };
            return es;
        };
    </script>
    













<script id="clean-grid-script">
setInterval(() => {
    const managerCard = document.getElementById('card-manager');
    if (managerCard) {
        const container = managerCard.parentElement;
        
        // بررسی اینکه آیا قبلاً اعمال شده یا نه (برای جلوگیری از رفرش بی‌مورد)
        if (container && container.style.gridTemplateColumns !== 'repeat(7, 1fr)') {
            
            // --- تنظیم کانتینر اصلی به گرید ۷ ستونی (۲ ردیف) ---
            container.className = 'custom-agents-grid';
            container.style.cssText = `
                display: grid !important;
                grid-template-columns: repeat(7, 1fr) !important;
                gap: 4px !important;
                width: 100% !important;
                padding: 8px !important;
                justify-items: center !important;
                align-items: start !important;
                overflow: hidden !important;
                height: auto !important;
            `;

            // --- تنظیم تک‌تک کارت‌ها ---
            const cards = container.querySelectorAll('.agent-card');
            cards.forEach(card => {
                // کوچیک کردن کارت و حذف استایل‌های مزاحم
                card.style.cssText = `
                    width: 100% !important;
                    height: 75px !important;
                    min-width: 0 !important;
                    padding: 4px !important;
                    margin: 0 !important;
                    border-radius: 8px !important;
                    background: rgba(30, 41, 59, 0.7) !important;
                    border: 1px solid rgba(139, 92, 246, 0.2) !important;
                    display: flex !important;
                    flex-direction: column !important;
                    align-items: center !important;
                    justify-content: flex-start !important; /* چیدمان از بالا */
                `;

                // کوچیک کردن و فشرده کردن آیکون
                const icon = card.querySelector('.text-xl');
                if (icon) {
                    icon.style.cssText = 'font-size: 16px !important; margin-bottom: 2px !important; filter: drop-shadow(0 0 4px rgba(139, 92, 246, 0.6));';
                }
                
                // کوچیک کردن اسم ایجنت
                const title = card.querySelector('.font-medium, .text-xs, .text-sm');
                if (title) {
                    title.style.cssText = 'font-size: 8px !important; color: #e2e8f0 !important; margin-bottom: 2px !important; line-height: 1 !important; white-space: nowrap !important;';
                }

                // --- بزرگ کردن چراغ وضعیت و انتقال آن به زیر اسم ---
                const status = card.querySelector('[id^="status-"]');
                if (status) {
                    status.style.cssText = `
                        position: static !important; /* خارج کردن از حالت مطلق */
                        width: 10px !important;     /* بزرگتر کردن سایز */
                        height: 10px !important;
                        border-radius: 50% !important;
                        background: #4b5563 !important; /* رنگ پیش‌فرض خاکستری */
                        margin-top: 2px !important;
                        display: block !important;
                        transition: all 0.3s !important;
                    `;
                    status.innerText = ''; // حذف کلمه Idle
                }
            });
        }
    }
}, 500);
</script>















<style id="content-tab-style">
    .content-view-container {
        display: none;
        padding: 20px;
        color: #d1d5db;
        overflow-y: auto;
        height: 100%;
        background: #1e1e2e;
        border-radius: 8px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        direction: rtl;
    }
    /* استایل برای مارک‌داون */
    .content-view-container h1, .content-view-container h2, .content-view-container h3 {
        color: #8b5cf6;
        margin-top: 1.2em;
        margin-bottom: 0.5em;
        font-weight: bold;
    }
    .content-view-container p { margin-bottom: 1em; line-height: 1.8; }
    .content-view-container ul { padding-right: 20px; list-style-type: disc; margin-bottom: 1em; }
    .content-view-container li { margin-bottom: 0.5em; }
    .content-view-container strong { color: #e5e7eb; }
</style>

<script id="ultimate-fix-script">
window.currentArticleText = "";

// تابع رنگ‌آمیزی چراغ‌ها
function updateAgentStatus(data) {
    if (!data || !data.agent) return;
    const agentName = data.agent.replace('Agent', '').trim().toLowerCase();
    
    // پیدا کردن چراغ
    let dot = document.querySelector(`[id="status-${agentName}"]`);
    if (!dot) dot = document.querySelector(`[id="status-${data.agent.toLowerCase()}"]`);
    
    if (dot) {
        const isDone = data.status === 'Done' || data.status === 'Complete' || data.status === 'Success';
        const isWorking = data.status === 'Working' || data.status === 'Thinking';
        
        if (isDone) {
            dot.style.setProperty('background-color', '#10b981', 'important'); // سبز
            dot.style.setProperty('box-shadow', '0 0 8px #10b981', 'important');
        } else if (isWorking) {
            dot.style.setProperty('background-color', '#f59e0b', 'important'); // زرد
            dot.style.setProperty('box-shadow', '0 0 8px #f59e0b', 'important');
        } else {
            dot.style.setProperty('background-color', '#ef4444', 'important'); // قرمز
            dot.style.setProperty('box-shadow', '0 0 5px #ef4444', 'important');
        }
    }
}

// رهگیری دیتای SSE برای رنگ چراغ‌ها
const originalEventSource = window.EventSource;
window.EventSource = function(url) {
    const es = new originalEventSource(url);
    const origAddEventListener = es.addEventListener;
    es.addEventListener = function(type, listener, options) {
        if (type === 'message' || type === 'log' || type === 'sse') {
            const wrapped = function(event) {
                try {
                    let data = JSON.parse(event.data);
                    updateAgentStatus(data);
                } catch(e) {}
                listener(event);
            };
            return origAddEventListener.call(es, type, wrapped, options);
        }
        return origAddEventListener.call(es, type, listener, options);
    };
    return es;
};

setInterval(() => {
    // --- ۱. اصلاح چراغ‌ها (بزرگتر، گوشه پایین راست، قرمز پیش‌فرض) ---
    const statusEls = document.querySelectorAll('[id^="status-"]');
    statusEls.forEach(el => {
        el.innerText = '';
        el.style.cssText = `
            position: absolute !important;
            bottom: 6px !important;
            right: 6px !important;
            width: 12px !important;
            height: 12px !important;
            border-radius: 50% !important;
            background-color: #ef4444 !important;
            box-shadow: 0 0 5px #ef4444 !important;
            border: none !important;
            margin: 0 !important;
            transition: all 0.3s !important;
        `;
        // اطمینان از اینکه کارت والد position: relative دارد
        const parentCard = el.closest('.agent-card');
        if (parentCard) {
            parentCard.style.setProperty('position', 'relative', 'important');
        }
    });

    // --- ۲. ساخت تب محتوا در پنل کد ---
    const codeContainer = document.getElementById('code-content') || document.querySelector('pre');
    if (!codeContainer) return;
    
    const toolbar = codeContainer.parentElement.parentElement.querySelector('div');
    if (!toolbar) return;

    if (!document.getElementById('btn-view-content')) {
        const btn = document.createElement('button');
        btn.id = 'btn-view-content';
        btn.className = 'bg-blue-600 hover:bg-blue-700 text-white px-3 py-1 rounded text-sm transition hidden';
        btn.innerText = '📄 Content';
        btn.onclick = toggleContentView;
        const saveBtn = Array.from(toolbar.querySelectorAll('button')).find(b => b.innerText.includes('Save'));
        if (saveBtn) saveBtn.parentNode.insertBefore(btn, saveBtn.nextSibling);
    }

    if (!document.getElementById('content-view-container')) {
        const contentDiv = document.createElement('div');
        contentDiv.id = 'content-view-container';
        contentDiv.className = 'content-view-container';
        
        const headerDiv = document.createElement('div');
        headerDiv.style.cssText = 'display:flex; justify-content:space-between; margin-bottom: 15px; border-bottom: 1px solid #374151; padding-bottom: 10px;';
        headerDiv.innerHTML = `
            <span style="font-weight:bold; color:#8b5cf6; font-size: 16px;">📄 Generated Article</span>
            <div>
                <button id="btn-copy-article" class="bg-gray-700 hover:bg-gray-600 text-white px-3 py-1 rounded text-sm mr-2 transition">Copy</button>
                <button id="btn-edit-article" class="bg-purple-600 hover:bg-purple-700 text-white px-3 py-1 rounded text-sm transition">Edit in Chat</button>
            </div>
        `;
        const textDiv = document.createElement('div');
        textDiv.id = 'article-text-body';
        
        contentDiv.appendChild(headerDiv);
        contentDiv.appendChild(textDiv);
        codeContainer.parentElement.appendChild(contentDiv);

        document.getElementById('btn-copy-article').onclick = () => {
            navigator.clipboard.writeText(window.currentArticleText);
            alert('متن کپی شد!');
        };
        document.getElementById('btn-edit-article').onclick = () => {
            const chatInput = document.querySelector('input[type="text"], textarea');
            if (chatInput) {
                chatInput.value = window.currentArticleText;
                toggleContentView();
            }
        };
    }

    // --- ۳. رهگیری متن‌های طولانی و تبدیل به مارک‌داون ---
    const chatBubbles = document.querySelectorAll('.chat-bubble, .prose, div[dir="rtl"]');
    chatBubbles.forEach(bubble => {
        if (bubble.innerText && bubble.innerText.length > 300 && !bubble.dataset.moved) {
            bubble.dataset.moved = 'true';
            window.currentArticleText = bubble.innerText;
            
            const btn = document.getElementById('btn-view-content');
            if (btn) btn.classList.remove('hidden');
            
            const textBody = document.getElementById('article-text-body');
            if (textBody) {
                // تبدیل مارک داون به HTML با کتابخانه marked.js
                if (typeof marked !== 'undefined') {
                    textBody.innerHTML = marked.parse(bubble.innerText);
                } else {
                    textBody.innerHTML = bubble.innerText.replace(/\n/g, '<br>');
                }
            }
            
            bubble.innerHTML = '<div style="color:#8b5cf6; padding:10px; text-align:center; font-weight:bold;">📄 مقاله تولید شد. برای مشاهده به تب Content در پنل کد بروید.</div>';
        }
    });
}, 1000);

function toggleContentView() {
    const codePre = document.querySelector('pre') || document.getElementById('code-content');
    const contentView = document.getElementById('content-view-container');
    if (codePre && contentView) {
        if (contentView.style.display === 'block') {
            contentView.style.display = 'none';
            codePre.style.display = 'block';
        } else {
            contentView.style.display = 'block';
            codePre.style.display = 'none';
        }
    }
}
</script>

</body>
</html>



