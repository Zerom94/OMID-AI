    <div style="background:#1e1e2e; width:100%; height:90%; border-radius:12px; display:flex; flex-direction:column; overflow:hidden; border:1px solid #374151; box-shadow: 0 10px 30px rgba(0,0,0,0.7);">
        <div style="padding:15px 20px; background:#111827; display:flex; justify-content:space-between; align-items:center; color:white; border-bottom: 1px solid #374151;">
            <span style="font-weight:bold; font-family:sans-serif; display:flex; align-items:center; gap:8px;">
                <span style="display:inline-block; width:10px; height:10px; background:#8b5cf6; border-radius:50%;"></span>
                Content Preview
            </span>
            <button onclick="document.getElementById('content-modal').style.display='none'" style="background:#ef4444; color:white; border:none; padding:8px 16px; border-radius:5px; cursor:pointer; font-weight:bold;">بستن</button>
        </div>
        <div id="content-modal-body" style="padding: 20px; color: #e5e7eb; overflow-y: auto; line-height: 1.8; font-size: 15px; white-space: pre-wrap; direction: rtl;"></div>
    </div>
</div>

<script>
    // رصد پیام‌های چت برای انتقال متن‌های طولانی به Modal
    const originalLogEvent = window.logEvent || function(){};
    window.logEvent = function(event, data) {
        if (originalLogEvent) originalLogEvent(event, data);
        
        // اگر پیام از سمت ContentAgent بود یا طولانی بود
        if (event === 'chat' && data.text) {
            const isContent = data.text.includes('###') || data.text.length > 500; 
            if (isContent) {
                const modal = document.getElementById('content-modal');
                const body = document.getElementById('content-modal-body');
                if (modal && body) {
                    body.innerHTML = data.text.replace(/\n/g, '<br>');
                    modal.style.display = 'flex';
                }
            }
        }
    };
</script>
<script>
setInterval(() => {
    if (document.getElementById('agent-content-card')) return;
    const spans = Array.from(document.querySelectorAll('span'));
    const managerSpan = spans.find(s => s.innerText === 'Manager');
    if (managerSpan) {
        const container = managerSpan.parentElement.parentElement;
        if (container) {
            const card = document.createElement('div');
            card.id = 'agent-content-card';
            card.style.cssText = 'display:flex; flex-direction:column; align-items:center; justify-content:center; margin: 0 5px;';
            card.innerHTML = '<div id="content-indicator" style="width:40px; height:40px; border-radius:50%; background:#1f2937; border:2px solid #374151; display:flex; align-items:center; justify-content:center; font-size:20px; transition:0.3s;">✍️</div><span style="font-size:10px; color:#9ca3af; margin-top:4px;">Content</span><span id="content-status" style="font-size:9px; color:#6b7280;">Idle</span>';
            container.appendChild(card);
        }
    }
}, 1000);
</script>
<style>
.flex.overflow-x-auto {
    flex-wrap: wrap !important;
    justify-content: center !important;
    height: auto !important;
    overflow-x: hidden !important;
    padding-bottom: 10px !important;
}
</style>
