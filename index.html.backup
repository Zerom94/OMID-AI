    .fixed.bottom-6.right-6 { transform: scale(1.3) !important; transform-origin: bottom right !important; }
    .omid-preview-btn { background-color: #8b5cf6 !important; color: white !important; border: none !important; padding: 4px 10px !important; border-radius: 6px !important; font-size: 14px !important; cursor: pointer !important; margin-left: 5px !important; }
    .omid-preview-btn:hover { background-color: #7c3aed !important; }
</style>
<div id="custom-preview-modal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.85); z-index:10000; justify-content:center; align-items:center;">
    <div style="background:#1e1e2e; width:90%; height:85%; border-radius:12px; display:flex; flex-direction:column; overflow:hidden;">
        <div style="padding:15px 20px; background:#111827; display:flex; justify-content:space-between; align-items:center; color:white;">
            <span style="font-weight:bold;">Live App Preview</span>
            <button id="close-custom-preview" style="background:#ef4444; color:white; border:none; padding:8px 16px; border-radius:5px; cursor:pointer;">Close</button>
        </div>
        <iframe id="custom-preview-iframe" style="width:100%; height:100%; border:none; background:white;"></iframe>
    </div>
</div>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const observer = new MutationObserver(() => {
            const saveBtn = Array.from(document.querySelectorAll('button')).find(b => b.innerText.includes('Save'));
            const codeElement = document.getElementById('code-content') || document.querySelector('pre');
        const isHtml = codeElement && (codeElement.innerText.includes('<!DOCTYPE html>') || codeElement.innerText.includes('<html'));
        if (saveBtn && isHtml && !document.getElementById('integrated-preview-btn')) {
                const btn = document.createElement('button');
                btn.id = 'integrated-preview-btn';
                btn.className = 'omid-preview-btn';
                btn.innerText = 'Preview';
                btn.onclick = showPreview;
                saveBtn.parentNode.insertBefore(btn, saveBtn.nextSibling);
            }
        });
        observer.observe(document.body, { childList: true, subtree: true });
        
        function showPreview() {
            const codeElement = document.getElementById('code-content') || document.querySelector('pre');
            if (!codeElement) return;
            let code = codeElement.innerText || codeElement.textContent;
            let startIndex = code.indexOf('<!DOCTYPE html>');
            if (startIndex === -1) startIndex = code.indexOf('<html');
            if (startIndex === -1) { alert('HTML not found'); return; }
            let endIndex = code.indexOf('```', startIndex);
            if (endIndex === -1) endIndex = code.length;
            document.getElementById('custom-preview-iframe').srcdoc = code.substring(startIndex, endIndex);
            document.getElementById('custom-preview-modal').style.display = 'flex';
        }
        document.getElementById('close-custom-preview').onclick = () => {
            document.getElementById('custom-preview-modal').style.display = 'none';
        };
    });
</script>

